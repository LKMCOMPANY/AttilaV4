# Copy to .env (gitignored) and fill in. Used only by scripts/deploy.sh.
# CF_ACCESS_* fall back to the app .env.local automatically if omitted here.

# root SSH password for the boxes
BOX_SSH_PASSWORD=

# Cloudflare Access service token (the "MagicBox SSH" token) — used to build
# the cloudflared SSH ProxyCommand for non-interactive deploys.
CF_ACCESS_CLIENT_ID=
CF_ACCESS_CLIENT_SECRET=
