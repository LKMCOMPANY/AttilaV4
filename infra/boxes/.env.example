# Copy to .env (gitignored) and fill in. Used only by scripts/deploy.sh.
# CF_ACCESS_* fall back to the app .env.local automatically if omitted here.

# root SSH password for the boxes
BOX_SSH_PASSWORD=

# Cloudflare Access service token (the "MagicBox SSH" token) — used to build
# the cloudflared SSH ProxyCommand for non-interactive deploys.
CF_ACCESS_CLIENT_ID=
CF_ACCESS_CLIENT_SECRET=

# Optional: scoped Cloudflare API token for the read-only control-plane drift
# checks in check-drift.mjs (DNS CNAMEs, tunnel health, cloudflared version,
# remote-managed tunnel config). Scopes: Zone→DNS:Read, Account→Cloudflare
# Tunnel:Read. Omit to skip the Cloudflare section (box/version checks still run).
CLOUDFLARE_API_TOKEN=
