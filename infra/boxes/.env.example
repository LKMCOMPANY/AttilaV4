# Copy to .env (gitignored) and fill in. Used by scripts/deploy.sh, check-drift.mjs,
# ../../scripts/box-power.mjs. CF_ACCESS_* fall back to the app .env.local if omitted.

# root SSH password for the boxes — BOOTSTRAP ONLY: once deploy.sh has installed
# the fleet key (files/authorized_keys.d/attila-fleet.pub) and the private key is
# in your agent (ssh-add --apple-use-keychain ~/.ssh/id_ed25519_attila), the
# password is never used. It disappears from the boxes with --lock-root-password.
BOX_SSH_PASSWORD=

# Private half of the fleet key (default ~/.ssh/id_ed25519_attila).
# BOX_SSH_KEY=

# Cloudflare Access service token (the "MagicBox SSH" token) — tunnel transport
# (SSH ProxyCommand + HTTPS) when a box is not on the current LAN, and the
# external /healthz check after every deploy.
CF_ACCESS_CLIENT_ID=
CF_ACCESS_CLIENT_SECRET=

# Optional: scoped Cloudflare API token for the read-only control-plane drift
# checks in check-drift.mjs (DNS CNAMEs, tunnel health, remote-managed tunnel
# config). Scopes: Zone→DNS:Read, Account→Cloudflare Tunnel:Read. Omit to skip
# the Cloudflare section (box/version/host checks still run).
CLOUDFLARE_API_TOKEN=

# Transport knobs: FORCE_TUNNEL=1 never uses the LAN; LAN_SWEEP=0 skips the /24
# sweep that populates the ARP table (ARP cache only).
