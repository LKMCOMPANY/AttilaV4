# MANAGED BY infra/boxes/files/logrotate.d/attila-mihomo — deployed by deploy.sh.
#
# cbs_go runs one host-side mihomo per running container and writes its config
# with "log-level": "debug", so every rule match, every sniffed SNI and every
# rejected QUIC attempt lands in state/<db_id>/mihomo.log — 1.46 GB for one
# device on box-1, 3.4 GB in total, on the eMMC root (25 Sep 2026). proxy_set
# has no log-level parameter, so the log is bounded here. copytruncate: the
# writer keeps its file descriptor, and cbs_go never reopens the file.
/root/armcloud-container-backend-service/state/*/mihomo.log
{
	rotate 1
	maxsize 20M
	daily
	missingok
	notifempty
	copytruncate
	compress
	nodateext
}
